{
  "name": "loadrift",
  "version": "0.2.28",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddv1982/load-rift.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json,js}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json,js}\" \".github/workflows/*.yml\"",
    "lint": "eslint src tests vite.config.ts playwright.config.ts",
    "preview": "vite preview",
    "install:k6": "bash scripts/install-k6.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser-smoke": "playwright test",
    "test:browser-smoke:update-screenshots": "LOADRIFT_UPDATE_DOCS_SCREENSHOTS=1 playwright test",
    "test:apt": "python3 -m unittest scripts/test_build_apt_repository.py",
    "test:installer": "sh scripts/test-install-apt-repo-rendering.sh",
    "test:supply-chain": "python3 -m unittest scripts/test_supply_chain.py",
    "evidence:supply-chain": "python3 scripts/verify_supply_chain_evidence.py local-check",
    "test:workflow-smoke": "vitest run src/app/App.validation.test.tsx src/features/import/useCollectionImport.test.tsx && npm run test:browser-smoke && cargo test --manifest-path src-tauri/Cargo.toml --locked imports_large_postman_collection_fixture",
    "benchmark:large-collection": "vitest bench src/benchmarks/largeCollection.bench.ts --run && LOADRIFT_BENCHMARK_IMPORT=1 cargo test --manifest-path src-tauri/Cargo.toml --locked imports_large_postman_collection_fixture -- --nocapture",
    "typecheck": "tsc --noEmit",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "audit:npm": "npm audit --audit-level=high",
    "rust:audit": "cargo audit --file src-tauri/Cargo.lock --deny unsound",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run audit:npm && npm run test:coverage && npm run test:apt && npm run test:installer && npm run test:supply-chain && npm run evidence:supply-chain && npm run test:workflow-smoke && npm run build && npm run rust:fmt && npm run rust:clippy && npm run rust:audit && cargo test --manifest-path src-tauri/Cargo.toml --locked && cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
